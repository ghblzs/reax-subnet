# Copy to router.env, fill in validator hotkey and EXACT model revision and tokenizer pins.
REAX_NETWORK=finney
REAX_NETUID=92
REAX_WALLET_NAME=reax
REAX_WALLET_HOTKEY=validator
REAX_ROUTER_ENABLED=0
REAX_ROUTER_MODELS=s1-fast
REAX_ROUTER_MODEL_REVISION=
REAX_ROUTER_TOKENIZER_VERSION=
# With REAX_ROUTER_MODELS=s1-fast,s1-pro each extra model needs its own pins (the pair above is the s1-fast default)
# and its tokenizer directory (REAX_ROUTER_TOKENIZER_DIR_S1_PRO):
# REAX_ROUTER_MODEL_REVISION_S1_PRO=c6b360d47895bb77bdf3805a13ee5a5557ab1921
# REAX_ROUTER_TOKENIZER_VERSION_S1_PRO=rune-26b-a4b-c6b360d
# Mainnet launch day has only the anchor miner: 1. Raise to 3 once more miners are eligible.
REAX_ROUTER_MIN_MINERS=1
REAX_ROUTER_MIN_EMA=0.9
REAX_ROUTER_MIN_ROUNDS=720
REAX_ROUTER_HOST=127.0.0.1
REAX_ROUTER_PORT=8080
REAX_ROUTER_TIMEOUT_S=3
# Per-miner limits; miners allow 2 concurrent / 20 per minute per caller, shared with the validator's rounds.
REAX_ROUTER_INFLIGHT_CAP=1
REAX_ROUTER_PER_MINER_PER_MINUTE=12
# A miner's first N customer answers are always verified; after that VERIFY_RATE of the answers are sampled.
# VERIFY_FLOOR of all requests is verified fail-closed; the rest of the sampled share is skipped (and counted) when
# the reference has no free slot. Fall back to the reference runtime when no miner answer can be served.
REAX_ROUTER_PROBATION_ANSWERS=20
REAX_ROUTER_VERIFY_RATE=1.0
REAX_ROUTER_VERIFY_FLOOR=0.1
REAX_ROUTER_REFERENCE_FALLBACK=1
REAX_ROUTER_SHADOW_RATE=0.05
# A timed-out/disconnected miner may still hold its per-caller slot: do not route to it for this many seconds (5..600).
REAX_ROUTER_TIMEOUT_QUARANTINE_S=60
REAX_ROUTER_MINER_TIMEOUT_S=1.5
# Router-wide concurrent reference computations, counted in decisions (1..16); extra requests get 503, never queue.
REAX_ROUTER_REFERENCE_CONCURRENCY=2
# Do not start a reference computation with less than this many seconds left before the deadline (0..5); such requests get 503.
REAX_ROUTER_MIN_REFERENCE_BUDGET_S=0.2
