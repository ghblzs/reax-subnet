# Copy to deploy/miner.env and fill in. No secrets here: the hotkey file is mounted, not pasted.
# This is the mpm1 (rc3 fallback) example; the mechanism must be named explicitly — the release
# default is s1. For the s1 miner use deploy/docker-compose.s1.yml (docs/MINER.md).
# Testnet and local endpoints need their own netuid.
REAX_MECHANISM=mpm1
REAX_NETWORK=finney
REAX_NETUID=92
REAX_WALLET_NAME=<coldkey name>
REAX_WALLET_HOTKEY=<hotkey name>
REAX_MODEL=qwen3-4b-instruct-2507
REAX_DEVICE=cuda
REAX_EXTERNAL_IP=<public ip of this machine>
REAX_EXTERNAL_PORT=8091
REAX_MINER_PORT=8091
