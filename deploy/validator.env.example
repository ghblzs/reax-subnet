# Copy to deploy/validator.env and fill in.
# This is the mpm1 (rc3 fallback) example; the mechanism must be named explicitly — the release
# default is s1. For the s1 validator use deploy/docker-compose.s1-validator.yml (docs/VALIDATOR.md).
# Testnet and local endpoints need their own netuid.
REAX_MECHANISM=mpm1
REAX_NETWORK=finney
REAX_NETUID=92
REAX_WALLET_NAME=<coldkey name>
REAX_WALLET_HOTKEY=<hotkey name>
REAX_MODEL=qwen3-4b-instruct-2507
REAX_DEVICE=cuda
REAX_LOG_JSON=1
# Start in shadow mode for the first hour, then set to 1.
REAX_SET_WEIGHTS=0
# Scoring parameters are fixed by the release; only the burn share is configurable (contract decision).
REAX_BURN_FRACTION=0
