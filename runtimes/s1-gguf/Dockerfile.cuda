# REAX s1-lite runtime sidecar, NVIDIA CUDA build for x86-64 (and arm64 SBSA servers such as GH200 / Jetson Thor).
#   docker build -f runtimes/s1-gguf/Dockerfile.cuda -t reax-s1-lite-runtime .
# Part of release 1.2 (tiered pools, docs/DESIGN-POOLS.md). Base pinned by digest at release time.
FROM nvidia/cuda:12.8.1-devel-ubuntu24.04 AS build
ENV DEBIAN_FRONTEND=noninteractive PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_NO_CACHE_DIR=1 PIP_BREAK_SYSTEM_PACKAGES=1
RUN apt-get update -qq && apt-get install -y -qq python3 python3-pip python3-dev build-essential cmake git >/dev/null \
 && rm -rf /var/lib/apt/lists/*
# Turing .. Blackwell consumer and data-centre cards (75 = T4/2080, 86 = 30xx/A-series, 89 = 40xx/L4, 120 = 50xx).
ARG CUDA_ARCHS="75;80;86;89;90;120"
RUN CMAKE_ARGS="-DGGML_CUDA=on -DGGML_NATIVE=OFF -DCMAKE_CUDA_ARCHITECTURES=${CUDA_ARCHS}" CMAKE_BUILD_PARALLEL_LEVEL=16 \
    pip wheel --no-deps -w /wheels "llama-cpp-python==0.3.36"
FROM nvidia/cuda:12.8.1-runtime-ubuntu24.04
ENV DEBIAN_FRONTEND=noninteractive PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_NO_CACHE_DIR=1 PIP_BREAK_SYSTEM_PACKAGES=1 \
    HF_HUB_OFFLINE=1 HF_HUB_DISABLE_TELEMETRY=1
RUN apt-get update -qq && apt-get install -y -qq python3 python3-pip curl libgomp1 >/dev/null && rm -rf /var/lib/apt/lists/*
COPY --from=build /wheels /wheels
RUN pip install -q /wheels/*.whl "numpy==2.3.3" "fastapi==0.115.14" "uvicorn==0.29.0" && rm -rf /wheels
ARG MODEL=s1-lite
RUN mkdir -p /opt/reax
COPY src/reax_subnet/manifests/${MODEL}-v1.json /opt/reax/manifest.json
COPY runtimes/s1-gguf/gguf_server.py runtimes/s1-gguf/readouts.py /opt/reax/
COPY LICENSE THIRD_PARTY_NOTICES.md /licenses/
RUN useradd --uid 10002 --create-home s1m
USER s1m
ENV REAX_MANIFEST=/opt/reax/manifest.json GGUF_MODEL_DIR=/model GGUF_N_GPU_LAYERS=-1 RUNTIME_HOST=127.0.0.1 \
    RUNTIME_PORT=8103 HOME=/tmp
HEALTHCHECK --interval=30s --timeout=5s --start-period=180s --retries=3 CMD curl -sf "http://127.0.0.1:${RUNTIME_PORT}/health" || exit 1
ENTRYPOINT ["python3", "/opt/reax/gguf_server.py"]
